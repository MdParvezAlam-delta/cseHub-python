SECRET_KEY=replace-with-a-strong-secret-key
DEBUG=False

# Backend domains/hosts (comma-separated)
ALLOWED_HOSTS=csehub.onrender.com,localhost,127.0.0.1

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE — priority order is: DATABASE_URL first, DB_* only as a fallback.
# Settings treats an empty or whitespace-only DATABASE_URL as "not set", so
# leaving the line present but blank is safe.
#
# 1) CLOUD (fill this in to use Supabase / Neon / Render Postgres):
#      DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
#    Keep `?sslmode=require` — managed providers refuse plaintext connections.
#
# 2) LOCAL (leave DATABASE_URL blank to fall through to DB_* below):
#    Locally:  DB_HOST=localhost, run your own Postgres, `python manage.py migrate`
#    In Docker: DB_HOST is overridden to `db` and you must add the profile:
#               docker compose --profile localdb up --build
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=

# Local fallback — used only when DATABASE_URL is empty.
# These are also what the `db` compose service is created with, so keep them
# aligned with each other.
DB_NAME=csehub_db
DB_USER=postgres
DB_PASSWORD=your-local-db-password
DB_HOST=localhost
DB_PORT=5432

# Host port the `db` container publishes to (only relevant with --profile localdb).
# Change this if you already run Postgres on 5432.
DB_PUBLISHED_PORT=5432

# Frontend origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
SECURE_SSL_REDIRECT=True

SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_URL=https://yourproject.supabase.co

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# RAG / Chatbot
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-pinecone-index-name
GEMINI_API_KEY=your-gemini-api-key

# Superuser (auto-created on first run)
DJANGO_SUPERUSER_EMAIL=admin@csehub.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=choose-a-strong-password

# ── Optional Docker tuning (defaults shown) ───────────────────────────────────
# Static files are baked into the image; set True only if you mount an empty
# volume over /app/backend/staticfiles.
DJANGO_COLLECTSTATIC=False
# Re-embedding every published article into Pinecone is slow and billable, so
# it is opt-in.
DJANGO_INGEST_ARTICLES=False
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# ─────────────────────────────────────────────────────────────────────────────
# Docker notes:
#   docker-compose.yml overrides DB_HOST, DB_PORT, ALLOWED_HOSTS,
#   CORS/CSRF origins, and DEBUG. Fill in the secrets above, then pick one:
#     Cloud DB (DATABASE_URL set):  docker compose up --build
#     Local DB (DATABASE_URL blank): docker compose --profile localdb up --build
# ─────────────────────────────────────────────────────────────────────────────
